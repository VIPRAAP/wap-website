// Validate email using regex
function validateEmail(string $email): bool {
    return (bool) preg_match('/^[\w\.-]+@[\w\.-]+\.[a-zA-Z]{2,}$/', $email);
}

// Validate password: min 8 chars, 1 uppercase, 1 digit, 1 special char
function validatePassword(string $pw): bool {
    return (bool) preg_match('/^(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{8,}$/', $pw);
}

// Format name: trim + capitalize each word
function formatName(string $name): string {
    return ucwords(strtolower(trim($name)));
}

// Extract domain from email
function extractDomain(string $email): string {
    preg_match('/@([\w\.-]+)$/', $email, $matches);
    return $matches[1] ?? 'invalid email';
}

// Extract username (part before @)
function extractUsername(string $email): string {
    preg_match('/^([\w\.-]+)@/', $email, $matches);
    return $matches[1] ?? 'invalid email';
}


